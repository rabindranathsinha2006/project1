# THE ULTIMATE SHOPPING Environment Configuration
DJANGO_SECRET_KEY=your-production-django-secret-key-here
DJANGO_DEBUG=False
ALLOWED_HOSTS=yourdomain.com,localhost,127.0.0.1,.onrender.com

# Database (Leave unset for default SQLite, or specify PostgreSQL URL for production)
DATABASE_URL=postgres://user:password@hostname:5432/ultimate_shop_db

# Security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
